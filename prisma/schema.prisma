generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  UNAVAILABLE
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  phone     String
  createdAt DateTime @default(now())

  reservations Reservation[]
  bookings     Booking[]

  @@index([phone])
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  durationMin Int
  language    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  shows Show[]

  @@index([isActive])
}

model Theater {
  id        String   @id @default(uuid())
  name      String
  city      String
  createdAt DateTime @default(now())

  screens Screen[]

  @@index([city])
}

model Screen {
  id        String @id @default(uuid())
  theaterId String
  name      String

  theater Theater @relation(fields: [theaterId], references: [id])
  seats   Seat[]
  shows   Show[]

  @@unique([theaterId, name])
  @@index([theaterId])
}

model Seat {
  id         String   @id @default(uuid())
  screenId   String
  seatRow    String
  seatNumber Int
  seatType   SeatType @default(REGULAR)

  screen    Screen     @relation(fields: [screenId], references: [id])
  showSeats ShowSeat[]

  @@unique([screenId, seatRow, seatNumber])
  @@index([screenId])
}

model Show {
  id        String     @id @default(uuid())
  movieId   String
  screenId  String
  startTime DateTime
  endTime   DateTime
  status    ShowStatus @default(SCHEDULED)

  movie  Movie      @relation(fields: [movieId], references: [id])
  screen Screen     @relation(fields: [screenId], references: [id])
  seats  ShowSeat[]

  reservations Reservation[]

  @@index([movieId, startTime])
  @@index([screenId, startTime])
}

model ShowSeat {
  id            String     @id @default(uuid())
  showId        String
  seatId        String
  status        SeatStatus @default(AVAILABLE)
  price         Decimal    @db.Decimal(10, 2)
  reservationId String?
  reservedUntil DateTime?

  show             Show              @relation(fields: [showId], references: [id])
  seat             Seat              @relation(fields: [seatId], references: [id])
  reservationSeats ReservationSeat[]

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([reservationId])
  @@index([reservedUntil])
}

model Reservation {
  id        String            @id @default(uuid())
  guestId   String
  showId    String
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  guest Guest @relation(fields: [guestId], references: [id])
  show  Show  @relation(fields: [showId], references: [id])

  seats   ReservationSeat[]
  booking Booking?

  @@index([showId, status])
  @@index([expiresAt])
}

model ReservationSeat {
  reservationId String
  showSeatId    String

  reservation Reservation @relation(fields: [reservationId], references: [id])
  showSeat    ShowSeat    @relation(fields: [showSeatId], references: [id])

  @@id([reservationId, showSeatId])
  @@index([showSeatId])
}

model Booking {
  id            String        @id @default(uuid())
  reservationId String        @unique
  guestId       String
  status        BookingStatus @default(PENDING_PAYMENT)
  totalAmount   Decimal       @db.Decimal(10, 2)
  ticketNumber  String?       @unique
  createdAt     DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])

  @@index([guestId])
  @@index([status])
}
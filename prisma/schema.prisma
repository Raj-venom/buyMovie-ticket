generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  UNAVAILABLE
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  WALLET
}

enum PaymentProvider {
  ESEWA
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())

  reservations Reservation[]
  bookings     Booking[]
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  durationMin Int
  language    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  shows Show[]

  @@index([isActive])
}

model Theater {
  id        String   @id @default(uuid())
  name      String
  city      String
  createdAt DateTime @default(now())

  screens Screen[]

  @@index([city])
}

model Screen {
  id        String @id @default(uuid())
  theaterId String
  name      String

  theater Theater @relation(fields: [theaterId], references: [id])
  seats   Seat[]
  shows   Show[]

  @@unique([theaterId, name])
  @@index([theaterId])
}

model Seat {
  id         String   @id @default(uuid())
  screenId   String
  seatRow    String
  seatNumber Int
  seatType   SeatType @default(REGULAR)

  screen    Screen     @relation(fields: [screenId], references: [id])
  showSeats ShowSeat[]

  @@unique([screenId, seatRow, seatNumber])
  @@index([screenId])
}

model Show {
  id        String     @id @default(uuid())
  movieId   String
  screenId  String
  startTime DateTime
  endTime   DateTime
  status    ShowStatus @default(SCHEDULED)

  movie  Movie      @relation(fields: [movieId], references: [id])
  screen Screen     @relation(fields: [screenId], references: [id])
  seats  ShowSeat[]

  reservations Reservation[]

  @@index([movieId, startTime])
  @@index([screenId, startTime])
}

model ShowSeat {
  id            String     @id @default(uuid())
  showId        String
  seatId        String
  status        SeatStatus @default(AVAILABLE)
  price         Decimal    @db.Decimal(10, 2)
  reservationId String?
  reservedUntil DateTime?

  show             Show              @relation(fields: [showId], references: [id])
  seat             Seat              @relation(fields: [seatId], references: [id])
  reservationSeats ReservationSeat[]
  bookingSeats     BookingSeat[]

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([reservationId])
  @@index([reservedUntil])
}

model Reservation {
  id        String            @id @default(uuid())
  guestId   String
  showId    String
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  guest Guest @relation(fields: [guestId], references: [id])
  show  Show  @relation(fields: [showId], references: [id])

  seats   ReservationSeat[]
  booking Booking?
  payment Payment?

  @@index([showId, status])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

model ReservationSeat {
  reservationId String
  showSeatId    String

  reservation Reservation @relation(fields: [reservationId], references: [id])
  showSeat    ShowSeat    @relation(fields: [showSeatId], references: [id])

  @@id([reservationId, showSeatId])
  @@index([showSeatId])
}

model Booking {
  id String @id @default(uuid())

  reservationId String @unique
  paymentId     String @unique
  guestId       String

  status BookingStatus @default(PENDING_PAYMENT)

  bookingNumber String @unique

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  currency String @default("NPR")

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])

  payment Payment @relation(fields: [paymentId], references: [id])

  guest Guest @relation(fields: [guestId], references: [id])

  seats BookingSeat[]

  @@index([guestId])
  @@index([status])
  @@index([createdAt])
}

model BookingSeat {
  id String @id @default(uuid())

  bookingId  String
  showSeatId String

  seatRow    String
  seatNumber Int
  seatType   SeatType

  price Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  showSeat ShowSeat @relation(fields: [showSeatId], references: [id])

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
}

model Payment {
  id            String @id @default(uuid())
  reservationId String @unique

  method   PaymentMethod
  provider PaymentProvider?

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("NPR")

  status PaymentStatus @default(PENDING)

  expiresAt DateTime
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])

  attempts PaymentAttempt[]
  booking  Booking?

  @@index([status])
  @@index([expiresAt])
  @@index([provider, status])
}

model PaymentAttempt {
  id        String @id @default(uuid())
  paymentId String

  attemptNo Int

  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2)

  idempotencyKey  String  @unique
  transactionUuid String? @unique

  providerTransactionId String?
  providerReference     String?
  providerBookingId     String?
  providerCorrelationId String?

  providerStatus String?

  providerResponse Json?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, attemptNo])
  @@index([paymentId, status])
  @@index([providerTransactionId])
  @@index([providerReference])
  @@index([providerBookingId])
  @@index([providerCorrelationId])
}
